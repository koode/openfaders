<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The engine reads each virtual device's mirrored input, which the system
	     treats as audio input; under the hardened runtime this entitlement is
	     required for the release build to capture it. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
